uv run python notebook_experiments/ibp/ebm_ibp.py   --ckpt notebook_experiments/golden_mean/ebm_ckpt.pt   --preset golden_mean --train_examples 100 --val_examples 2000   --num_probe_datasets 20 --use_probe_head --ft_steps 50 --ft_lr 1e-3   --eval_batch_size 512 --log_next_token_metrics   --output notebook_experiments/ibp/ebm_ibp_gm_probe_nt.json
