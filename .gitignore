# Minimal Pipeline: Keep essential files, ignore outputs
# nanoGPT outputs (training checkpoints and logs)
nanoGPT/out-*/
nanoGPT/log/

# Generated datasets (keep structure, ignore large data files)
experiments/datasets/*/*.dat
experiments/datasets/*/*.states
experiments/datasets/*/*.states.dat
!experiments/datasets/*/*.meta.json
!experiments/datasets/*/*.machine.json

# Results and analysis outputs
experiments/results/
results/

